NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=baari

JWT_SECRET=replace-with-a-long-random-secret
OTP_HASH_SECRET=replace-with-a-different-long-random-secret
TYPEORM_SYNCHRONIZE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Baari <no-reply@baari.local>

EMAIL_QUEUE_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Razorpay — obtain from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Cloud Messaging — Server Key from Firebase Console > Project Settings > Cloud Messaging
FCM_SERVER_KEY=

# Fast2SMS — obtain from https://www.fast2sms.com
FAST2SMS_API_KEY=
